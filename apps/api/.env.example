# BuskinaTicket API — Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://buskinaticket:password@localhost:5432/buskinaticket_dev"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT RS256 ───────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ─── QR Code ECDSA P-256 ─────────────────────────────────────────────────────
# Generate with: openssl ecparam -name prime256v1 -genkey -noout -out ec_private.pem
#                openssl ec -in ec_private.pem -pubout -out ec_public.pem
QR_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
QR_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Orange Money ────────────────────────────────────────────────────────────
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/bf/v1"
ORANGE_MONEY_CLIENT_ID=your_client_id
ORANGE_MONEY_CLIENT_SECRET=your_client_secret
ORANGE_MONEY_WEBHOOK_SECRET=your_webhook_secret
ORANGE_MONEY_IPS="41.x.x.x,41.x.x.x"  # IP whitelist opérateur

# ─── Moov Money ──────────────────────────────────────────────────────────────
MOOV_MONEY_API_URL="https://developer.moov-africa.com/bf/v1"
MOOV_MONEY_API_KEY=your_api_key
MOOV_MONEY_WEBHOOK_SECRET=your_webhook_secret
MOOV_MONEY_IPS="196.x.x.x"

# ─── Wave ────────────────────────────────────────────────────────────────────
WAVE_API_URL="https://api.wave.com/v1"
WAVE_API_KEY=your_api_key
WAVE_WEBHOOK_SECRET=your_webhook_secret
WAVE_IPS=""

# ─── Africa's Talking (SMS) ───────────────────────────────────────────────────
AFRICAS_TALKING_API_KEY=your_api_key
AFRICAS_TALKING_USERNAME=your_username
AFRICAS_TALKING_SENDER_ID=BuskinaTicket

# ─── Twilio (WhatsApp) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# ─── Application ──────────────────────────────────────────────────────────────
APP_DOMAIN=buskinaticket.bf
API_BASE_URL=https://api.buskinaticket.bf
SMS_BASE_URL=https://sms.buskinaticket.bf
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
